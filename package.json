{
  "name": "student-code-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:studio": "bun --env-file=.env run drizzle-kit studio",
    "db:generate": "bun --env-file=.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=.env run drizzle-kit migrate",
    "db:migrate:test": "bun --env-file=.env run drizzle-kit migrate --config=drizzle.test.config.ts",
    "db:seed:admin": "bun --env-file=.env run scripts/seed-superadmin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/pg": "^8.23.1",
    "@uiw/react-codemirror": "^4.25.7",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.12",
    "openai": "^4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8",
    "prettier": "^3.9.8",
    "pyodide": "0.27.7",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0"
  }
}
