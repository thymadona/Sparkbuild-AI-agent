# Postgres connection string (server-side only). The application's single data
# connection: Drizzle + postgres.js talk to it directly, and it is the only
# database configuration the app needs. There is no Supabase client any more —
# authentication is Better Auth and every query goes through lib/db/client.ts.
#
# It connects as the database owner and therefore bypasses RLS, which is why
# every scoped query carries its own ownership predicate.
#
# Local setup (Postgres 17, matching production):
#   createdb spark_build && bun run db:migrate
#
# Any Postgres will do. `lib/db/client.ts` sets `prepare: false`, so a pooler
# in transaction mode works as well as a direct connection.
DATABASE_URL=postgresql://postgres@localhost:5432/spark_build

# Tests get their own database, and it stays LOCAL — the harness truncates
# every table between suites, so lib/db/client.ts refuses to run if this
# matches DATABASE_URL. Jest migrates it automatically before any suite
# (jest.globalSetup.ts); `bun run db:migrate:test` does the same by hand.
#
#   createdb spark_build_test && bun run db:migrate:test
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/spark_build_test

# --- Authentication (Better Auth) ---
# Signs and encrypts session cookies. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret
# The app's own origin. Better Auth builds the OAuth redirect from this, so a
# wrong value shows up as Google's redirect_uri_mismatch error.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Add <BETTER_AUTH_URL>/api/auth/callback/google to that client's authorized
# redirect URIs. If this app previously signed in through Supabase, these are
# the same credentials that were pasted into the Supabase dashboard — reuse
# the client rather than creating a new one.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Bootstraps the first admin, since roles are granted from /staff/users and
# only an admin can reach it: `bun run db:seed:admin`. The account is created
# with no credential; the named person claims it by signing in with Google on
# this address. Optional once someone holds the admin role.
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_NAME=Your Name

DEEPSEEK_API_KEY=your_deepseek_api_key
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_SITE_URL=https://vercellink.com
# Redis — one connection string for every environment. Backs the prompt rate
# limiter (lib/ratelimit.ts) and the read cache (lib/cache.ts).
#   local:      redis://127.0.0.1:6379    (brew install redis && brew services start redis)
#   production: rediss://default:<password>@<host>:6379
# For Upstash, use the "Redis protocol" / TLS endpoint (rediss://), NOT the REST
# URL — the client speaks the Redis wire protocol, not Upstash's HTTP API.
#
# OPTIONAL. Both callers fail open, so the app boots, builds and serves without
# it; you just get no caching and no rate limiting.
REDIS_URL=redis://127.0.0.1:6379

# Used instead of REDIS_URL when NODE_ENV=test, so a test run cannot evict or
# overwrite development cache entries. Defaults to database 15 on a local server
# if unset, which is why `bun run test` needs no Redis configuration.
TEST_REDIS_URL=redis://127.0.0.1:6379/15