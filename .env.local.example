NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Postgres connection string for Drizzle (server-side only). From Supabase
# dashboard: Project Settings -> Database -> Connect -> "Transaction" pooler
# (port 6543). Bypasses RLS like SUPABASE_SERVICE_ROLE_KEY does.
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres
DEEPSEEK_API_KEY=your_deepseek_api_key
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_SITE_URL=https://vercellink.com
# Upstash Redis (REST API). From the Upstash console: create a Redis database,
# then Details -> REST API. Backs the prompt rate limiter (lib/ratelimit.ts)
# and the read cache (lib/cache.ts).
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token